# Copy to .env and fill in your own key. .env is git-ignored; never commit it.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536
# MIN_SCORE=0.2
# RATE_LIMIT_QUERY=10/minute
# RATE_LIMIT_DOCUMENTS=60/minute

# Only needed when running outside Docker Compose (compose sets these itself):
# QDRANT_URL=http://localhost:6333
# API_URL=http://127.0.0.1:8000
# INNGEST_URL=http://127.0.0.1:8288
